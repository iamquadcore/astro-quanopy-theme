{
  "name": "astro-quanopy-theme",
  "description": "An Astro blog theme with a sidebar and two-column post cards.",
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "keywords": [
    "astro",
    "astro-integration",
    "withastro",
    "theme",
    "blog"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./content": {
      "types": "./content.d.ts",
      "default": "./content.mjs"
    },
    "./layouts/*": "./src/layouts/*"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "content.mjs",
    "content.d.ts",
    "src"
  ],
  "scripts": {
    "dev": "astro dev --root playground",
    "build": "astro build --root playground",
    "preview": "astro preview --root playground",
    "check": "astro check --root playground"
  },
  "peerDependencies": {
    "astro": "^7.4.4"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "remark-breaks": "^4.0.0",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.7",
    "astro": "^7.4.4",
    "typescript": "^6.0.3"
  }
}
