---
import { getCollection, render } from 'astro:content';
import { excerpt, ogImage, readingMinutes, toArray, toSlug } from '../lib/posts';
import { site } from 'virtual:quanopy/config';
import Layout from '../layouts/Layout.astro';
import CopyCode from '../components/CopyCode.astro';
import OtherArticles from '../components/OtherArticles.astro';
import PostMeta from '../components/PostMeta.astro';
import PostNav from '../components/PostNav.astro';
import PostTerms from '../components/PostTerms.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.data.permalink }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, updated } = post.data;
const description = post.data.description || excerpt(post.body, 120) || undefined;
const image = await ogImage(post);
const tags = toArray(post.data.tags);
const category = toArray(post.data.categories)[0];

// 構造化データ: 記事 (BlogPosting) とパンくず (BreadcrumbList)
const home = Astro.site && new URL(import.meta.env.BASE_URL, Astro.site).href;
const url = home && new URL(Astro.url.pathname, Astro.site).href;
const abs = (path: string) => home && new URL(path.replace(/^\//, ''), home).href;
const schema = home ? [
  {
    '@type': 'BlogPosting',
    '@id': url + '#article',
    mainEntityOfPage: url,
    headline: title,
    ...(description && { description }),
    ...(image && { image: new URL(image.src, home).href }),
    datePublished: date.toISOString(),
    dateModified: (updated ?? date).toISOString(),
    author: { '@id': home + '#author', '@type': 'Person', name: site.author.name, url: home },
    publisher: { '@id': home + '#author' },
    inLanguage: 'ja',
    ...(tags.length && { keywords: tags.join(', ') }),
    ...(category && { articleSection: category }),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { name: 'Home', item: home },
      ...(category ? [{ name: category, item: abs(`/categories/${toSlug(category)}/`) }] : []),
      { name: title, item: url },
    ].map((x, i) => ({ '@type': 'ListItem', position: i + 1, ...x })),
  },
] : [];
---
<Layout title={title} heading={title} description={description} image={image} type="article" noindex={post.data.hidden} article={{ published: date, modified: updated, tags }} schema={schema}>
  <PostMeta date={date} updated={updated} minutes={readingMinutes(post.body)} />
  <article class="prose"><Content /></article>
  <PostTerms post={post} />
  <CopyCode />
  <PostNav post={post} />
  <OtherArticles post={post} />
</Layout>
