---
import { site } from 'virtual:quanopy/config';
// 手元の確認(dev)では計測しない
const id = import.meta.env.PROD ? site.googleAnalytics : undefined;
---
{id && (
  <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(id)}`}></script>
  <script is:inline define:vars={{ id }}>
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { dataLayer.push(arguments); };
    gtag('js', new Date());
    gtag('config', id);
  </script>
)}
