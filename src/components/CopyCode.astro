---
import Icon from './Icon.astro';
---
<template id="copy-icons">
  <span data-state="copy"><Icon name="fa-regular fa-copy" /></span>
  <span data-state="done"><Icon name="fa-solid fa-check" /></span>
  <span data-state="fail"><Icon name="fa-solid fa-xmark" /></span>
</template>
<script>
  // コードブロックにコピーボタンを付ける(クリップボードが使えない環境では付けない)
  const icons = document.querySelector<HTMLTemplateElement>('#copy-icons')!.content;
  const iconOf = (s: string) => icons.querySelector(`[data-state="${s}"] svg`)!;
  for (const box of navigator.clipboard ? document.querySelectorAll('.prose .code-box') : []) {
    const pre = box.querySelector('pre')!;
    const btn = document.createElement('button');
    btn.type = 'button';
    box.querySelector('.code-head')!.append(btn);
    const state = (s: string, label: string) => { btn.replaceChildren(iconOf(s).cloneNode(true)); btn.ariaLabel = btn.title = label; };
    const reset = () => { state('copy', 'コードをコピー'); btn.classList.remove('done'); };
    reset();
    let timer: ReturnType<typeof setTimeout>;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText((pre.textContent ?? '').replace(/\n$/, ''));
        state('done', 'コピーしました');
        btn.classList.add('done');
      } catch {
        state('fail', 'コピーできませんでした');
      }
      clearTimeout(timer);
      timer = setTimeout(reset, 2000);
    });
  }
</script>
