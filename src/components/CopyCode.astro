<script>
  // コードブロックにコピーボタンを付ける(クリップボードが使えない環境では付けない)
  for (const box of navigator.clipboard ? document.querySelectorAll('.prose .code-box') : []) {
    const pre = box.querySelector('pre')!;
    const btn = document.createElement('button');
    btn.type = 'button';
    const icon = document.createElement('i');
    icon.setAttribute('aria-hidden', 'true');
    btn.append(icon);
    box.querySelector('.code-head')!.append(btn);
    const state = (cls: string, label: string) => { icon.className = cls; btn.ariaLabel = btn.title = label; };
    const reset = () => { state('fa-regular fa-copy', 'コードをコピー'); btn.classList.remove('done'); };
    reset();
    let timer: ReturnType<typeof setTimeout>;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText((pre.textContent ?? '').replace(/\n$/, ''));
        state('fa-solid fa-check', 'コピーしました');
        btn.classList.add('done');
      } catch {
        state('fa-solid fa-xmark', 'コピーできませんでした');
      }
      clearTimeout(timer);
      timer = setTimeout(reset, 2000);
    });
  }
</script>
