---
import PostCard from './PostCard.astro';
import type { Post } from '../lib/posts';
interface Props { title: string; posts: Post[]; number?: number; featured?: number }
const { title, posts, number = posts.length, featured = 0 } = Astro.props;
---
<section>
  <div class="section-head"><h2>{title}</h2><span>{String(number).padStart(2, '0')}</span></div>
  {featured > 0 && <div class="grid featured">{posts.slice(0, featured).map((post) => <PostCard post={post} />)}</div>}
  <div class="grid">{posts.slice(featured).map((post) => <PostCard post={post} row />)}</div>
</section>
