---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { site } from '../site.config';
interface Props { title?: string; heading?: string }
const { title, heading = site.title } = Astro.props;
---
<!doctype html>
<html lang="ja" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={site.description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title ? title + ' | ' + site.title : site.title}</title>
    <script is:inline>
      try { if (localStorage.getItem('theme') === 'light') document.documentElement.classList.remove('dark'); } catch {}
    </script>
  </head>
  <body>
    <div class="hero-bg" aria-hidden="true"><img src={site.hero.src} alt="" /></div>
    <Header />
    <div class="page">
      <Sidebar />
      <main>
        <div class="hero-text"><p>{site.subtitle}</p><h1>{heading}</h1></div>
        <slot />
      </main>
    </div>
  </body>
</html>
