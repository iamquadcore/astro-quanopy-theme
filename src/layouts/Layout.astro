---
import '@fortawesome/fontawesome-free/css/fontawesome.min.css';
import '@fortawesome/fontawesome-free/css/brands.min.css';
import '@fortawesome/fontawesome-free/css/regular.min.css';
import '@fortawesome/fontawesome-free/css/solid.min.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import { site } from 'virtual:quanopy/config';
interface Props { title?: string; heading?: string }
const { title, heading = site.title } = Astro.props;
---
<!doctype html>
<html lang="ja" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={site.description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title ? title + ' | ' + site.title : site.title}</title>
    <script is:inline>
      try { if (localStorage.getItem('theme') === 'light') document.documentElement.classList.remove('dark'); } catch {}
      // ページ切り替えの間だけ、要素に切り替え用の名前を付ける(常に付けると背景のぼかしが効かなくなる)
      {
        const c = document.documentElement.classList;
        addEventListener('pageswap', (e) => { if (e.viewTransition) c.add('page-out'); });
        addEventListener('pagereveal', (e) => {
          c.remove('page-out');
          if (!e.viewTransition) return;
          c.add('page-in');
          const done = () => c.remove('page-in');
          e.viewTransition.finished.then(done, done);
        });
      }
    </script>
  </head>
  <body>
    <div class="hero-bg" aria-hidden="true"><img src={site.hero.src} alt="" /></div>
    <Header />
    <div class="page">
      <Sidebar />
      <main>
        <div class="hero-text"><p>{site.subtitle}</p><h1>{heading}</h1></div>
        <slot />
        <Footer />
      </main>
    </div>
  </body>
</html>
