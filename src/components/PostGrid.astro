---
import PostCard from './PostCard.astro';
import type { Post } from '../lib/posts';
interface Props { title: string; posts: Post[] }
const { title, posts } = Astro.props;
---
<section>
  <div class="section-head"><h2>{title}</h2><span>{String(posts.length).padStart(2, '0')}</span></div>
  <div class="grid">{posts.map((post) => <PostCard post={post} />)}</div>
</section>
