---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import Hero from '../components/Hero.astro';
import Search from '../components/Search.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import { asOgImage, type OgImage } from '../lib/posts';
import { canonicalUrl } from '../lib/canonical';
import { site } from 'virtual:quanopy/config';
interface Props {
  title?: string;
  heading?: string;
  description?: string;
  image?: OgImage;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** 記事ページの情報。OGP の article:* と構造化データに使う */
  article?: { published: Date; modified?: Date; tags: string[] };
  /** ページ固有の構造化データ (JSON-LD のノード) */
  schema?: Record<string, unknown>[];
}
const { title, heading = site.title, description = site.description, type = 'website', noindex = false } = Astro.props;
// 404 と noindex のページは検索結果に出さないので、正規 URL も示さない
const notFound = /^\/404(\/|\.html)?$/.test(Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), ''));
const robotsNoindex = noindex || notFound;
const canonical = robotsNoindex ? undefined : canonicalUrl(Astro.url.pathname, Astro.site);
const image = Astro.props.image ?? (site.ogImage ? asOgImage(site.ogImage) : undefined);
const imageUrl = image && new URL(image.src, Astro.site ?? Astro.url).href;
const shareTitle = title ?? site.title;
const { article } = Astro.props;

// 構造化データ。URL は絶対 URL でなければならないので、site が未設定なら出さない
const home = Astro.site && new URL(import.meta.env.BASE_URL, Astro.site).href;
const person = home && { '@type': 'Person', '@id': home + '#author', name: site.author.name, url: home, description: site.author.bio, ...(site.social.length && { sameAs: site.social.map((s) => s.href).filter((h) => /^https?:/.test(h)) }) };
const schema = home && !robotsNoindex ? [
  ...(canonical?.href === home ? [{ '@type': 'WebSite', '@id': home + '#website', url: home, name: site.title, description: site.description, inLanguage: 'ja', publisher: { '@id': home + '#author' } }, person] : []),
  ...(Astro.props.schema ?? []),
] : [];
const jsonLd = schema.length > 0 && JSON.stringify({ '@context': 'https://schema.org', '@graph': schema }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="ja" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {site.feed && home && <link rel="alternate" type="application/atom+xml" title={site.title} href={new URL('atom.xml', home).href} />}
    <meta name="description" content={description} />
    {robotsNoindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical.href} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical.href} />}
    {image && (<Fragment>
      <meta property="og:image" content={imageUrl} />
      <meta property="og:image:alt" content={shareTitle} />
      <meta property="og:image:width" content={String(image.width)} />
      <meta property="og:image:height" content={String(image.height)} />
      <meta name="twitter:image" content={imageUrl} />
      <meta name="twitter:image:alt" content={shareTitle} />
    </Fragment>)}
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    {site.twitter && (<Fragment>
      <meta name="twitter:site" content={site.twitter} />
      <meta name="twitter:creator" content={site.twitter} />
    </Fragment>)}
    {article && (<Fragment>
      <meta property="article:published_time" content={article.published.toISOString()} />
      {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
      <meta property="article:author" content={site.author.name} />
      {article.tags.map((t) => <meta property="article:tag" content={t} />)}
    </Fragment>)}
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <title>{title ? title + ' | ' + site.title : site.title}</title>
    <script is:inline>
      try { if (localStorage.getItem('theme') === 'light') document.documentElement.classList.remove('dark'); } catch {}
      // ページ切り替えの間だけ、要素に切り替え用の名前を付ける(常に付けると背景のぼかしが効かなくなる)
      {
        const c = document.documentElement.classList;
        addEventListener('pageswap', (e) => { if (e.viewTransition) c.add('page-out'); });
        addEventListener('pagereveal', (e) => {
          c.remove('page-out');
          if (!e.viewTransition) return;
          c.add('page-in');
          const done = () => c.remove('page-in');
          e.viewTransition.finished.then(done, done);
        });
      }
    </script>
    <Analytics />
  </head>
  <body>
    <Hero />
    <Header />
    <div class="page">
      <Sidebar />
      <main>
        <div class="hero-text"><p>{site.subtitle}</p><h1>{heading}</h1></div>
        <slot />
        <Footer />
      </main>
    </div>
    {site.search && <Search />}
  </body>
</html>
