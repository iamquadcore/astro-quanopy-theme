---
import { site } from 'virtual:quanopy/config';
import { getImage } from 'astro:assets';
import { faIcon } from '../lib/icons';
import { countBy, getListedPosts, toSlug } from '../lib/posts';
const tags = countBy(await getListedPosts(), 'tags');
// 表示は 104px。高解像度の画面向けに 2 倍まで用意する (SVG はそのまま)
const avatar = site.author.avatar;
const avatarImg = avatar.format === 'svg'
  ? { src: avatar.src, srcSet: { attribute: undefined } }
  : await getImage({ src: avatar, width: 104, height: 104, fit: 'cover', densities: [1, 2], format: 'webp' });
---
<aside class:list={['sidebar', { 'sidebar-scroll': site.sidebar.scroll }]}>
  <img class="avatar" src={avatarImg.src} srcset={avatarImg.srcSet.attribute} sizes="104px" alt="" width="104" height="104" decoding="async" />
  <p class="name">{site.author.name}</p>
  <p class="bio">{site.author.bio}</p>
  <hr />
  <ul class="social">{site.social.map((s) => {
    const icon = s.icon && faIcon(s.icon);
    return <li>{icon
      ? <a class="social-icon" href={s.href} rel="noopener" aria-label={s.label} title={s.label} set:html={icon} />
      : <a href={s.href} rel="noopener">{s.label}</a>}</li>;
  })}</ul>
  <hr />
  <dl>{site.info.map((i) => <div><dt>{i.key}:</dt><dd>{i.value}</dd></div>)}</dl>
  <hr />
  <ul class="tags">{tags.map(([t, n]) => <li><a href={'/tags/' + toSlug(t) + '/'}>{t}（{n}）</a></li>)}</ul>
</aside>
<script>
  // スクロールなしで画面より縦長のとき、下端まで見えてから追従させるために高さを渡す
  const el = document.querySelector<HTMLElement>('.sidebar:not(.sidebar-scroll)');
  if (el) new ResizeObserver(() => el.style.setProperty('--sidebar-actual', el.offsetHeight + 'px')).observe(el);
</script>
